{
    "name": "linkhub/linkhub",
    "type": "project",
    "description": "LinkHub – Link- und Applikationsportal mit eigenen Konten und optionaler AD/LDAP-Anmeldung (Laravel, Docker, SQLite)",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.0",
        "laravel/framework": "^13.0",
        "league/commonmark": "^2.6",
        "spatie/laravel-activitylog": "^4.12"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
